#!/bin/sh

changed=0

set_opt() {
	local key=$1
	local val=$2

	if ! uci -q get "luci.$key" 2>/dev/null; then
		uci set "luci.$key=$val"
		changed=1
	fi
}

set_opt themes.Round /luci-static/round

if [ "$PKG_UPGRADE" != 1 ] && [ $changed = 1 ]; then
	set_opt main.mediaurlbase /luci-static/round
fi

if [ $changed = 1 ]; then
	uci commit luci
fi

# register ucode cache handler for theme static assets (idempotent)
H=/usr/share/ucode/luci-round/round-cache.uc

add_prefix() {
	grep -qF "$1=$2" /etc/config/uhttpd 2>/dev/null || {
		uci -q add_list uhttpd.main.ucode_prefix="$1=$2"
		changed=1
	}
}

add_prefix /luci-static/round "$H"
add_prefix /luci-static/resources/menu-round.js "$H"
add_prefix /luci-static/resources/view/round "$H"

if [ $changed = 1 ]; then
	uci commit uhttpd
	/etc/init.d/uhttpd restart
fi

exit 0
